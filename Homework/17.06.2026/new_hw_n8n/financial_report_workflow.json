              "id": "prompt",
              "name": "prompt",
              "value": "=You are a financial document analysis assistant.\n\nAnalyze the following quarterly financial report and return ONLY valid JSON.\n\nDo not give investment advice.\nDo not recommend buying, selling, or holding any stock.\nOnly summarize and analyze the financial information inside the document.\n\nReturn this exact JSON structure:\n\n{\n  \"document_type\": \"one of: earnings_summary, budget_proposal, expense_report, other\",\n  \"company\": \"company name\",\n  \"ticker\": \"stock ticker if mentioned, otherwise null\",\n  \"fiscal_quarter\": \"Q1/Q2/Q3/Q4 if mentioned\",\n  \"fiscal_year\": \"year if mentioned\",\n  \"report_date\": \"date if mentioned\",\n  \"currency\": \"currency used in the report\",\n  \"summary\": \"2-3 sentence summary of the report\",\n  \"financial_metrics\": {\n    \"revenue\": \"revenue amount and change if mentioned\",\n    \"net_income\": \"net income amount and change if mentioned\",\n    \"eps\": \"earnings per share if mentioned\",\n    \"expenses\": \"major expense numbers if mentioned\",\n    \"cash_flow\": \"cash flow information if mentioned\",\n    \"guidance\": \"future guidance if mentioned\"\n  },\n  \"key_findings\": [\"finding 1\", \"finding 2\", \"finding 3\"],\n  \"risks\": [\"risk 1\"],\n  \"sentiment\": \"positive, neutral, or negative\",\n  \"risk_level\": \"low, medium, or high\",\n  \"entities\": {\n    \"organizations\": [],\n    \"people\": [],\n    \"dates\": [],\n    \"amounts\": []\n  },\n  \"action_items\": [\"action 1\"],\n  \"confidence_score\": 0.0\n}\n\nDocument text:\n{{ $json.extracted_text }}",
              "type": "string"
            },
            {
              "id": "filename",
              "name": "filename",
              "value": "={{ $json.filename }}",
              "type": "string"
            },
