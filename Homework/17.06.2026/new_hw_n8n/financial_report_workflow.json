    {
      "parameters": {
        "jsCode": "const prep = $('Prepare Agent Context').first().json;\nconst agent = $input.first().json;\nconst raw = agent.output || agent.text || JSON.stringify(agent);\n\nlet parsed = {};\ntry {\n  const cleaned = String(raw).replace(/^```json\\s*/i, '').replace(/\\s*```$/, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch {\n  try {\n    parsed = JSON.parse(prep.analysis_json || '{}');\n  } catch {\n    parsed = { summary: String(raw) };\n  }\n}\n\nconst m = parsed.financial_metrics || {};\nconst revenue = parsed.revenue || m.revenue || '';\nconst netIncome = parsed.net_income || m.net_income || '';\nconst eps = parsed.eps || m.eps || '';\nconst expenses = parsed.expenses || m.expenses || '';\nconst cashFlow = m.cash_flow || '';\nconst guidance = parsed.guidance || m.guidance || '';\nconst keyFindings = Array.isArray(parsed.key_findings) ? parsed.key_findings.join('; ') : (parsed.key_findings || '');\nconst risks = Array.isArray(parsed.risks) ? parsed.risks.join('; ') : (parsed.risks || '');\nconst actionItems = Array.isArray(parsed.action_items) ? parsed.action_items.join('; ') : (parsed.action_items || '');\n\nconst filename = prep.filename;\nconst summaryFilename = filename.replace(/\\.[^.]+$/, '') + '_summary.md';\n\nconst markdown = [\n  '# Financial Report Analysis',\n  '',\n  '## Company',\n  `${parsed.company || 'Unknown'} (${parsed.ticker || 'N/A'})`,\n  '',\n  '## Period',\n  `${parsed.fiscal_quarter || ''} ${parsed.fiscal_year || ''}`.trim(),\n  '',\n  '## Document Type',\n  parsed.document_type || '',\n  '',\n  '## Summary',\n  parsed.summary || '',\n  '',\n  '## Key Metrics',\n  `- Revenue: ${revenue}`,\n  `- Net Income: ${netIncome}`,\n  `- EPS: ${eps}`,\n  `- Expenses: ${expenses}`,\n  `- Cash Flow: ${cashFlow}`,\n  `- Guidance: ${guidance}`,\n  '',\n  '## Sentiment',\n  parsed.sentiment || '',\n  '',\n  '## Risk Level',\n  parsed.risk_level || '',\n  '',\n  '## Key Findings',\n  keyFindings,\n  '',\n  '## Risks',\n  risks,\n  '',\n  '## Action Items',\n  actionItems,\n].join('\\n');\n\nreturn [{ json: { markdown, summary_filename: summaryFilename } }];"
      },
